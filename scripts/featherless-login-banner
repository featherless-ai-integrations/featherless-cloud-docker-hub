#!/bin/sh

# Login shells source this file through /etc/profile.d. Keep non-interactive
# commands and machine-readable SSH output clean.
case "$-" in
  *i*) ;;
  *) return 0 2>/dev/null || exit 0 ;;
esac
[ -t 1 ] || return 0 2>/dev/null || exit 0
[ "${FEATHERLESS_BANNER_SHOWN:-}" = 1 ] && return 0 2>/dev/null || true
FEATHERLESS_BANNER_SHOWN=1
export FEATHERLESS_BANNER_SHOWN

case "${FEATHERLESS_GPU_COUNT:-}" in
  ''|*[!0-9]*)
    gpu_count=0
    for render_node in /dev/dri/renderD*; do
      [ -e "$render_node" ] && gpu_count=$((gpu_count + 1))
    done
    ;;
  *) gpu_count=$FEATHERLESS_GPU_COUNT ;;
esac

cpu_count=''
if [ -r /sys/fs/cgroup/cpu.max ]; then
  read -r cpu_quota cpu_period < /sys/fs/cgroup/cpu.max
  if [ "$cpu_quota" != max ] && [ "${cpu_period:-0}" -gt 0 ] 2>/dev/null; then
    cpu_count=$(( (cpu_quota + cpu_period - 1) / cpu_period ))
  fi
elif [ -r /sys/fs/cgroup/cpu/cpu.cfs_quota_us ] && \
     [ -r /sys/fs/cgroup/cpu/cpu.cfs_period_us ]; then
  cpu_quota=$(cat /sys/fs/cgroup/cpu/cpu.cfs_quota_us)
  cpu_period=$(cat /sys/fs/cgroup/cpu/cpu.cfs_period_us)
  if [ "$cpu_quota" -gt 0 ] 2>/dev/null && [ "$cpu_period" -gt 0 ] 2>/dev/null; then
    cpu_count=$(( (cpu_quota + cpu_period - 1) / cpu_period ))
  fi
fi
[ -n "$cpu_count" ] || cpu_count=$(nproc 2>/dev/null || printf '?')

memory_bytes=''
if [ -r /sys/fs/cgroup/memory.max ]; then
  memory_bytes=$(cat /sys/fs/cgroup/memory.max)
elif [ -r /sys/fs/cgroup/memory/memory.limit_in_bytes ]; then
  memory_bytes=$(cat /sys/fs/cgroup/memory/memory.limit_in_bytes)
fi
case "$memory_bytes" in
  ''|max|*[!0-9]*) memory_bytes=$(awk '/^MemTotal:/ { print $2 * 1024; exit }' /proc/meminfo) ;;
esac
memory_gib=$(awk -v bytes="$memory_bytes" 'BEGIN { printf "%.0f", bytes / 1073741824 }')

format_uptime() {
  elapsed=$1
  days=$((elapsed / 86400))
  hours=$((elapsed % 86400 / 3600))
  minutes=$((elapsed % 3600 / 60))
  if [ "$days" -gt 0 ]; then
    printf '%s day%s %s hr%s' "$days" "$([ "$days" -eq 1 ] || printf s)" \
      "$hours" "$([ "$hours" -eq 1 ] || printf s)"
  elif [ "$hours" -gt 0 ]; then
    printf '%s hr%s %s min%s' "$hours" "$([ "$hours" -eq 1 ] || printf s)" \
      "$minutes" "$([ "$minutes" -eq 1 ] || printf s)"
  else
    printf '%s min%s' "$minutes" "$([ "$minutes" -eq 1 ] || printf s)"
  fi
}

format_capacity() {
  awk -v value="$1" 'BEGIN {
    text = sprintf("%.0f", value)
    result = ""
    while (length(text) > 3) {
      result = "," substr(text, length(text) - 2) result
      text = substr(text, 1, length(text) - 3)
    }
    printf "%s%s GiB", text, result
  }'
}

storage_usage() {
  capacity_gib=$1
  mount_path=$2
  command -v timeout >/dev/null 2>&1 || { printf '—'; return; }
  used_kib=$(timeout 1 du -sxk -- "$mount_path" 2>/dev/null | awk 'NR == 1 { print $1 }')
  case "$used_kib" in
    ''|*[!0-9]*) printf '—' ;;
    *) awk -v used="$used_kib" -v capacity="$capacity_gib" \
      'BEGIN { percent = int((used * 100) / (capacity * 1048576)); if (percent > 100) percent = 100; printf "%d%%", percent }' ;;
  esac
}

uptime_seconds=$(ps -o etimes= -p 1 2>/dev/null | tr -d ' ')
case "$uptime_seconds" in
  ''|*[!0-9]*) uptime_summary='Unavailable' ;;
  *) uptime_summary=$(format_uptime "$uptime_seconds") ;;
esac

storage_rows=''
if command -v jq >/dev/null 2>&1 && printf '%s' "${FEATHERLESS_STORAGE_JSON:-}" | jq -e \
  'type == "array" and length > 0 and all(.[]; (.name | type == "string") and (.capacityGiB | type == "number" and . > 0) and (.mountPath | type == "string"))' \
  >/dev/null 2>&1; then
  storage_rows=$(printf '%s' "$FEATHERLESS_STORAGE_JSON" | jq -r '.[] | [
    (.name | gsub("[\u0000-\u001f\u007f]"; " ") | if length > 20 then .[0:19] + "…" else . end),
    (.capacityGiB | floor | tostring),
    (.mountPath | gsub("[\u0000-\u001f\u007f]"; " "))
  ] | @tsv')
fi
if [ -z "$storage_rows" ]; then
  workspace_type=$(findmnt -rn -T /workspace -o FSTYPE 2>/dev/null | head -n 1)
  case "$workspace_type" in
    nfs*) workspace_name='Network volume' ;;
    ceph|fuse.ceph) workspace_name='Volume disk' ;;
    *) workspace_name='Container disk' ;;
  esac
  workspace_capacity=$(df -Pk /workspace 2>/dev/null | awk 'NR == 2 { printf "%.0f", $2 / 1048576 }')
  case "$workspace_capacity" in
    ''|*[!0-9]*) ;;
    *) storage_rows=$(printf '%s\t%s\t/workspace' "$workspace_name" "$workspace_capacity") ;;
  esac
fi

if [ "${TERM:-dumb}" != dumb ] && [ -z "${NO_COLOR:-}" ]; then
  accent='\033[1;33m'
  muted='\033[0;90m'
  bright='\033[1;97m'
  cyan='\033[1;36m'
  green='\033[1;32m'
  yellow='\033[1;33m'
  red='\033[1;31m'
  reset='\033[0m'
else
  accent=''
  muted=''
  bright=''
  cyan=''
  green=''
  yellow=''
  red=''
  reset=''
fi

printf '%b' "$accent"
cat <<'EOF'
    ______          __  __               __
   / ____/__  ____ _/ /_/ /_  ___  _____/ /__  __________
  / /_  / _ \/ __ `/ __/ __ \/ _ \/ ___/ / _ \/ ___/ ___/
 / __/ /  __/ /_/ / /_/ / / /  __/ /  / /  __(__  |__  )
/_/    \___/\__,_/\__/_/ /_/\___/_/  /_/\___/____/____/
EOF
printf '%b%38s%b\n' "$muted" 'GPU CLOUD' "$reset"
printf '\n%bInstance%b  %b%s%b\n' "$muted" "$reset" "$bright" "$(hostname)" "$reset"
if [ "$gpu_count" -gt 0 ] 2>/dev/null; then
  [ "$gpu_count" -eq 1 ] && gpu_label='GPU' || gpu_label='GPUs'
  resources="$gpu_count AMD $gpu_label · $cpu_count vCPU · $memory_gib GiB RAM"
else
  resources="$cpu_count vCPU · $memory_gib GiB RAM"
fi
printf '%bResources%b %b%s%b\n' "$muted" "$reset" "$bright" "$resources" "$reset"
printf '%bUptime%b    %b%s%b\n' "$muted" "$reset" "$bright" "$uptime_summary" "$reset"
if [ -n "${FEATHERLESS_COST_PER_HOUR_USD:-}" ]; then
  printf '%bCost%b      %b%s / hr%b\n' "$muted" "$reset" "$cyan" "$FEATHERLESS_COST_PER_HOUR_USD" "$reset"
fi

if [ -n "$storage_rows" ]; then
  printf '\n%b%-20s %10s %6s   %s%b\n' "$muted" 'Storage' 'Capacity' 'Used' 'Mount' "$reset"
  tab=$(printf '\t')
  while IFS="$tab" read -r storage_name capacity_gib mount_path; do
    capacity=$(format_capacity "$capacity_gib")
    usage=$(storage_usage "$capacity_gib" "$mount_path")
    case "$usage" in
      *%)
        usage_number=${usage%%%}
        if [ "$usage_number" -ge 90 ]; then usage_color=$red
        elif [ "$usage_number" -ge 70 ]; then usage_color=$yellow
        else usage_color=$green
        fi
        ;;
      *) usage_color=$muted ;;
    esac
    printf '%b%-20s%b %10s %b%6s%b   %s\n' \
      "$bright" "$storage_name" "$reset" "$capacity" "$usage_color" "$usage" "$reset" "$mount_path"
  done <<EOF
$storage_rows
EOF
fi
printf '\n'
