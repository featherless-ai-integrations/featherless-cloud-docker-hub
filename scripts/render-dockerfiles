#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
template="$repo_root/templates/rocm.Dockerfile"
check=false
[[ "${1:-}" == --check ]] && check=true
# shellcheck source=../versions.env
source "$repo_root/versions.env"

render() {
  local output="$1" base="$2" description="$3" temporary
  local -a source_templates=("${4:-$template}")
  [[ -z "${5:-}" ]] || source_templates+=("$5")
  temporary="$(mktemp)"
  sed -e "s|@@BASE_IMAGE@@|${base}|g" \
      -e "s|@@DESCRIPTION@@|${description}|g" \
      -e "s|@@LXCFS_PACKAGE_VERSION@@|${LXCFS_PACKAGE_VERSION}|g" \
      -e "s|@@AXOLOTL_COMMIT@@|${AXOLOTL_COMMIT}|g" \
      -e "s|@@AXOLOTL_VERSION@@|${AXOLOTL_VERSION}|g" \
      "${source_templates[@]}" > "$temporary"

  if $check; then
    if ! cmp -s "$temporary" "$repo_root/$output"; then
      printf 'ERROR: %s is stale; run scripts/render-dockerfiles\n' "$output" >&2
      rm -f "$temporary"
      return 1
    fi
    rm -f "$temporary"
  else
    mkdir -p "$(dirname "$repo_root/$output")"
    mv "$temporary" "$repo_root/$output"
    printf 'Rendered %s\n' "$output"
  fi
}

render Dockerfile \
  "$PYTORCH_BASE" \
  'Featherless AI ROCm development image for AMD Instinct MI325X'
render docker-image/rocm-pytorch/Dockerfile \
  "$PYTORCH_BASE" \
  'Featherless AI ROCm PyTorch image for AMD Instinct MI325X'
render docker-image/rocm-sgl/Dockerfile \
  "$SGL_BASE" \
  'Featherless AI ROCm SGLang image for AMD Instinct MI325X'
render docker-image/rocm-vllm/Dockerfile \
  "$VLLM_BASE" \
  'Featherless AI ROCm vLLM image for AMD Instinct MI325X'
render docker-image/rocm-axolotl/Dockerfile \
  "$AXOLOTL_BASE" \
  'Featherless Cloud Axolotl ROCm training image for AMD Instinct MI325X' \
  "$template" \
  "$repo_root/templates/axolotl.Dockerfile"

render docker-image/core-lxcfs/Dockerfile \
  "$LXCFS_BASE" \
  "Featherless Cloud LXCFS node service" \
  "$repo_root/templates/core-lxcfs.Dockerfile"
