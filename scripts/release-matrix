#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../versions.env
source "$repo_root/versions.env"

jq -nc \
  --arg pt "$PYTORCH_IMAGE_TAG" \
  --arg pts "$PYTORCH_BASE" \
  --arg sgl "$SGL_IMAGE_TAG" \
  --arg sgls "$SGL_BASE" \
  --arg vllm "$VLLM_IMAGE_TAG" \
  --arg vllms "$VLLM_BASE" \
  '{include: [
    {target:"pytorch", repository:"rocm-pytorch", version:$pt, source:$pts},
    {target:"sgl-dev", repository:"rocm-sgl", version:$sgl, source:$sgls},
    {target:"vllm", repository:"rocm-vllm", version:$vllm, source:$vllms}
  ]}'
